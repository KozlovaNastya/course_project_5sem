// Ресурсы плагина. Главное - JSON_PIPL: описание плагина (PiPL), которое читает Photoshop.
#include <windows.h>

JSON_PIPL JSON "../pipl/PiPLs.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Gaussian Blur 3x3 (Photoshop filter plug-in)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "GaussianBlur"
            VALUE "OriginalFilename", "GaussianBlur.8bf"
            VALUE "ProductName", "Gaussian Blur 3x3"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
