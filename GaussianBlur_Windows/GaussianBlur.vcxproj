<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6D1F3A52-8B7C-4E2A-9C41-5A0B7E2D4F10}</ProjectGuid>
    <RootNamespace>GaussianBlur</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- Берётся тот набор инструментов, который стоит по умолчанию в вашей Visual Studio (2019/2022/...). -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)PhotoshopSdk.props" />

  <PropertyGroup>
    <TargetName>GaussianBlur</TargetName>
    <TargetExt>.8bf</TargetExt>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;$(PhotoshopSdkDir)photoshopapi\photoshop;$(PhotoshopSdkDir)photoshopapi\pica_sp;$(PhotoshopSdkDir)samplecode\common\includes;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32=1;_WINDOWS;_USRDLL;GAUSSIANBLUR_EXPORTS;ISOLATION_AWARE_ENABLED=1;_CRT_SECURE_NO_DEPRECATE;_SCL_SECURE_NO_DEPRECATE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <Culture>0x0409</Culture>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <!-- Статическая CRT: плагину не нужен установленный VC++ Redistributable. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\GaussianBlurCore.cpp" />
    <ClCompile Include="src\GaussianBlurPlugin.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\GaussianBlurCore.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="win\GaussianBlur.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="pipl\PiPLs.json" />
    <None Include="PhotoshopSdk.props" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Понятная ошибка, если SDK не найден. -->
  <Target Name="CheckPhotoshopSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PhotoshopSdkDir)photoshopapi\photoshop\PIFilter.h')"
           Text="Photoshop SDK не найден: '$(PhotoshopSdkDir)'. Распакуйте photoshop-cpp-sdk-main рядом с этой папкой или задайте переменную окружения PHOTOSHOP_SDK_DIR (путь к папке pluginsdk). См. README_Windows.md." />
  </Target>
</Project>
